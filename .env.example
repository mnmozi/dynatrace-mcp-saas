# Dynatrace SaaS MCP — environment configuration
# Copy to .env and fill in. .env is gitignored.

# --- Hosts ---
# Partial-credential mode: you may provide just ONE pair and omit the other.
#   Platform-only (Gen3 tenants): set DT_PLATFORM_URL + DT_PLATFORM_TOKEN; leave DT_CLASSIC_* unset.
#   Classic-only: set DT_CLASSIC_URL + DT_API_TOKEN; leave DT_PLATFORM_* unset.
#   Full dual-host: set all four (recommended when both APIs are available).
# Each pair must be entirely set or entirely absent — a half-set pair is a startup error.
#
# Platform host (Gen3 "apps"): serves /platform/* APIs
DT_PLATFORM_URL=https://asn8731h.sprint.apps.dynatracelabs.com
# Classic host: serves /api/v1 and /api/v2
DT_CLASSIC_URL=https://asn8731h.sprint.dynatracelabs.com

# --- Tokens ---
# Platform token (dt0s16...) — Bearer auth for /platform/* (DQL, documents, SLO, synthetic)
DT_PLATFORM_TOKEN=
# Classic API token (dt0c01...) — Api-Token auth for /api/v2 (settings, problems, entities, metrics).
# ALSO used for OpenPipeline ingest (ingest_openpipeline_events / raw_post): the /platform/ingest/*
# endpoints are served on the ENVIRONMENT/classic host, so this token must carry the matching scope —
# openpipeline.events, openpipeline.sdlc, openpipeline.events_security, openpipeline.events_smartscape
# (custom endpoints use the .custom variant, e.g. openpipeline.events.custom).
# These are the Api-Token (dot-style) scope names. A Platform token uses the IAM colon-style
# equivalents instead (openpipeline:events:ingest, openpipeline:security.events:ingest) — the
# MCP reaches these endpoints via Api-Token, so grant the dot-style scopes on THIS token.
DT_API_TOKEN=

# --- Guardrails ---
# Writes (create/update/delete) are BLOCKED unless this is exactly "true"
DT_ENABLE_WRITES=false

# Optional: default request timeout (ms)
DT_HTTP_TIMEOUT_MS=30000

# Optional: retry tunables. Retry safety is method/data-aware (see src/http/retry.ts):
#   GET/PUT/DELETE  → retry on 429/408, 5xx, and network errors
#   config POST     → retry on 429/408 and network, but NOT 5xx (avoid a duplicate config)
#   data ingest     → retry ONLY on 429/408 (a retried log/event would DUPLICATE the record)
# DT_MAX_RETRIES=3       # max retries within the class above (default 3)
# DT_RETRY_BASE_MS=500   # base delay for exponential backoff in ms (default 500)

# --- IAM (optional) ---
# Dedicated platform token carrying iam:* scopes (iam:boundaries:read/write,
# iam:policies:read/write, iam:bindings:read/write, iam:effective-permissions:read).
# IAM tools use this token when set; otherwise they fall back to DT_PLATFORM_TOKEN.
# Lets you keep the main token unchanged — this one needs ONLY the iam scopes.
# DT_IAM_TOKEN=

# --- Account Management API (optional; powers all account-scoped tools) ---
# Create an OAuth client under myaccount (Identity & access management > OAuth clients).
# All three of CLIENT_ID / CLIENT_SECRET / ACCOUNT_URN must be set together.
#
# IMPORTANT — scopes: each account API needs its OWN scope, and the SSO rejects a
# multi-scope token request (400 invalid_request), so a token is fetched per scope.
# Grant the OAuth client EVERY scope for the tools you want (a missing scope fails at
# token time). See the iam_reference topic "account-api-operations" for the full map:
#   iam-policies-management  → policies / boundaries / bindings
#   account-idm-read         → list groups, users, memberships, platform-tokens
#   account-idm-write        → create/update/delete groups; create/delete platform-tokens
#   account-uac-read         → subscriptions / cost / usage
# DT_OAUTH_CLIENT_ID=
# DT_OAUTH_CLIENT_SECRET=
# DT_ACCOUNT_URN=urn:dtaccount:<account-uuid>
# DT_OAUTH_SCOPE sets only the DEFAULT scope (each tool overrides it per call as needed).
# DT_OAUTH_SCOPE=iam-policies-management
# Optional host overrides (defaults: production SSO/API). Sprint/hardening tenants must
# point these at the matching environment — the public host rejects sprint SSO tokens.
# DT_SSO_TOKEN_URL=https://sso.dynatrace.com/sso/oauth2/token
# DT_ACCOUNT_API_URL=https://api.dynatrace.com
