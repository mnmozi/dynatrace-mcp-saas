# Dynatrace SaaS MCP — environment configuration
# Copy to .env and fill in. .env is gitignored.

# --- Hosts ---
# Partial-credential mode: you may provide just ONE pair and omit the other.
#   Platform-only (Gen3 tenants): set DT_PLATFORM_URL + DT_PLATFORM_TOKEN; leave DT_CLASSIC_* unset.
#   Classic-only: set DT_CLASSIC_URL + DT_API_TOKEN; leave DT_PLATFORM_* unset.
#   Full dual-host: set all four (recommended when both APIs are available).
# Each pair must be entirely set or entirely absent — a half-set pair is a startup error.
#
# Platform host (Gen3 "apps"): serves /platform/* APIs
DT_PLATFORM_URL=https://asn8731h.sprint.apps.dynatracelabs.com
# Classic host: serves /api/v1 and /api/v2
DT_CLASSIC_URL=https://asn8731h.sprint.dynatracelabs.com

# --- Tokens ---
# Platform token (dt0s16...) — Bearer auth for /platform/* (DQL, documents, SLO, synthetic)
DT_PLATFORM_TOKEN=
# Classic API token (dt0c01...) — Api-Token auth for /api/v2 (settings, problems, entities, metrics)
DT_API_TOKEN=

# --- Guardrails ---
# Writes (create/update/delete) are BLOCKED unless this is exactly "true"
DT_ENABLE_WRITES=false

# Optional: default request timeout (ms)
DT_HTTP_TIMEOUT_MS=30000

# Optional: retry tunables
# DT_MAX_RETRIES=3       # max number of retries on 429/408/5xx/network errors (default 3)
# DT_RETRY_BASE_MS=500   # base delay for exponential backoff in ms (default 500)

# --- IAM (optional) ---
# Dedicated platform token carrying iam:* scopes (iam:boundaries:read/write,
# iam:policies:read/write, iam:bindings:read/write, iam:effective-permissions:read).
# IAM tools use this token when set; otherwise they fall back to DT_PLATFORM_TOKEN.
# Lets you keep the main token unchanged — this one needs ONLY the iam scopes.
# DT_IAM_TOKEN=

# --- Account Management API (optional; needed for IAM policy boundaries) ---
# Create an OAuth client under myaccount (Identity & access management > OAuth clients)
# with the iam-policies-management scope. All three must be set together.
# DT_OAUTH_CLIENT_ID=
# DT_OAUTH_CLIENT_SECRET=
# DT_ACCOUNT_URN=urn:dtaccount:<account-uuid>
# Optional host overrides (defaults: production SSO/API)
# DT_SSO_TOKEN_URL=https://sso.dynatrace.com/sso/oauth2/token
# DT_ACCOUNT_API_URL=https://api.dynatrace.com
