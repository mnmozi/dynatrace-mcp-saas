{
  "name": "dynatrace-saas-mcp",
  "version": "0.1.0",
  "description": "MCP server for Dynatrace SaaS (Gen3 platform): observability + configuration tools (DQL, settings, dashboards, SLOs, synthetic, OpenPipeline) with schema drift detection.",
  "type": "module",
  "bin": {
    "dynatrace-saas-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "refresh-snapshots": "tsx scripts/refresh-snapshots.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "msw": "^2.4.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "author": "Mostafa Nasr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnmozi/dynatrace-mcp-saas.git"
  },
  "bugs": {
    "url": "https://github.com/mnmozi/dynatrace-mcp-saas/issues"
  },
  "homepage": "https://github.com/mnmozi/dynatrace-mcp-saas#readme",
  "keywords": [
    "dynatrace",
    "mcp",
    "model-context-protocol",
    "observability",
    "grail",
    "dql",
    "openpipeline",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "specs",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
