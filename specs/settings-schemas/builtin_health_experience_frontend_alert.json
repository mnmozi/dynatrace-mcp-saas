      "nullable": false,
      "precondition": {
        "type": "EQUALS",
        "property": "analyzerType",
        "expectedValue": "StaticThreshold"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    },
    "actor": {
      "displayName": "Actor",
      "description": "The user for which the alert gets executed",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "actor-validator",
          "skipAsyncValidation": false
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "actor-permission-validator",
          "skipAsyncValidation": false
        },
