      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": true
    },
    "title": {
      "displayName": "Name of the frontend alert",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 2
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "frontends": {
      "displayName": "Array of Frontends to configure the alert for",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "Frontend",
        "description": "",
        "documentation": "",
        "type": "text",
        "constraints": [
          {
            "type": "PATTERN",
            "pattern": "^(MOBILE_)?APPLICATION\\-[A-F0-9]{16}$"
          },
          {
            "type": "LENGTH",
            "maxLength": 500,
            "minLength": 1
          }
        ]
      },
      "nullable": false,
      "minObjects": 1,
      "maxObjects": 100,
      "modificationPolicy": "DEFAULT"
    },
    "alertKey": {
      "displayName": "Alert Key",
      "description": "",
      "documentation": "",
