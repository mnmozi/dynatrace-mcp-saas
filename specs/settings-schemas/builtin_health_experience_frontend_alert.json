        "$ref": "#/enums/AlertKey"
      },
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "errorRateRequestErrors"
    },
    "analyzerType": {
      "displayName": "Analyzer Type",
      "description": "",
      "documentation": "",
      "type": {
        "$ref": "#/enums/AnalyzerType"
      },
      "nullable": true,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    },
    "autoAdaptiveAnalyzerInput": {
      "displayName": "autoAdaptiveAnalyzerInput",
      "description": "",
      "documentation": "",
      "type": {
        "$ref": "#/types/AutoAdaptiveAnalyzerInput"
      },
      "nullable": false,
      "precondition": {
        "type": "OR",
        "preconditions": [
          {
            "type": "EQUALS",
            "property": "analyzerType",
            "expectedValue": "AutoAdaptive"
          },
          {
            "type": "AND",
            "preconditions": [
              {
                "type": "NULL",
                "property": "analyzerType"
              },
              {
                "type": "IN",
                "property": "alertKey",
                "expectedValues": [
                  "webVitalsLcp",
                  "webVitalsInp",
                  "webVitalsCls",
                  "mobileAppStartDuration",
                  "userActionDuration"
                ]
              }
            ]
          }
        ]
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    },
    "seasonalBaselineAnalyzerInput": {
      "displayName": "seasonalBaselineAnalyzerInput",
      "description": "",
      "documentation": "",
      "type": {
        "$ref": "#/types/SeasonalBaselineAnalyzerInput"
      },
      "nullable": false,
      "precondition": {
        "type": "OR",
        "preconditions": [
          {
            "type": "EQUALS",
            "property": "analyzerType",
            "expectedValue": "SeasonalBaseline"
          },
          {
            "type": "AND",
            "preconditions": [
              {
                "type": "NULL",
                "property": "analyzerType"
              },
              {
                "type": "IN",
                "property": "alertKey",
                "expectedValues": [
                  "errorRateRequestErrors",
                  "errorRateExceptions",
                  "mobileCrash",
                  "mobileAnr",
                  "trafficDrop",
                  "trafficSpike"
                ]
              }
            ]
          }
        ]
      },
      "maxObjects": 1,
