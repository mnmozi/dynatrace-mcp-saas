{
  "dynatrace": "1",
  "schemaId": "builtin:devobs.sensitive.data.masking",
  "displayName": "Sensitive Data Masking",
  "description": "Create rules to mask any information you consider to be sensitive. Masking is done on OneAgent and no personal data is sent or stored on Dynatrace servers.",
  "documentation": "",
  "schemaGroups": [
    "group:observability-for-developers"
  ],
  "version": "0.5.2",
  "multiObject": true,
  "ordered": true,
  "maxObjects": 100,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "environment"
  ],
  "enums": {
    "ruleType": {
      "displayName": "Rule Type",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "VAR_NAME",
          "displayName": "Redact by variable name",
          "description": "Redact the value of all variables that match a name. The entire value will be masked."
        },
        {
          "value": "REGEX",
          "displayName": "Redact by regex",
          "description": "Redact any values that match the regex you supply here."
        }
      ],
      "type": "enum"
    },
    "replacementType": {
      "displayName": "Data Replacement",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "STRING",
          "displayName": "Replace with string",
          "description": "Optionally choose a string to replace the data being masked. The default value is ***."
        },
        {
          "value": "SHA256",
          "displayName": "Replace with SHA-256",
          "description": "Redacted data will be replaced with a SHA-256 hash string."
        }
      ],
      "type": "enum"
    },
    "comparisonType": {
      "displayName": "Comparison Type",
      "description": "Choose how to match the variable name.",
      "documentation": "",
      "items": [
        {
          "value": "EQUALS",
          "displayName": "Equals",
          "description": "Match variables with names that are exactly the same as the input (e.g., 'foo' matches only 'foo')."
        },
        {
          "value": "CONTAINS",
          "displayName": "Contains",
          "description": "Match variables with names that include the input string (e.g., 'foo' matches 'myfoobar' or 'foo123')."
        },
        {
          "value": "STARTS_WITH",
          "displayName": "Starts with",
          "description": "Match variables with names that begin with the input string (e.g., 'foo' matches 'foobar' or 'foo123')."
        },
        {
          "value": "ENDS_WITH",
          "displayName": "Ends with",
          "description": "Match variables with names that end with the input string (e.g., 'foo' matches 'myfoo' or 'barfoo')."
        }
      ],
      "type": "enum"
    }
  },
  "types": {},
  "properties": {
    "ruleName": {
      "displayName": "Rule Name",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 3
        },
        {
          "type": "TRIMMED",
          "customMessage": "No leading or trailing whitespaces are allowed."
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "New Rule"
    },
    "enabled": {
      "displayName": "Active",
      "description": "",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": true
    },
    "ruleType": {
      "displayName": "Rule Type",
      "description": "Choose whether to redact by variable name or regex.",
      "documentation": "",
      "type": {
        "$ref": "#/enums/ruleType"
      },
      "subType": "select",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "VAR_NAME"
    },
    "ruleVarName": {
      "displayName": "Variable Name",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 1
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "ruleType",
        "expectedValue": "VAR_NAME"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "comparisonType": {
      "displayName": "Comparison Type",
      "description": "Select how the variable name should be matched.",
      "documentation": "",
      "type": {
        "$ref": "#/enums/comparisonType"
      },
      "subType": "select",
      "nullable": false,
      "precondition": {
        "type": "EQUALS",
        "property": "ruleType",
        "expectedValue": "VAR_NAME"
      },
      "metadata": {
        "minAgentVersion": "1.329"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "EQUALS"
    },
    "ruleRegex": {
      "displayName": "Regex Pattern",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "logMonitoringRegexValidator",
          "skipAsyncValidation": false
        },
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 1
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "ruleType",
        "expectedValue": "REGEX"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "replacementType": {
      "displayName": "Data Replacement",
      "description": "Choose how the sensitive data should be replaced.",
      "documentation": "",
      "type": {
        "$ref": "#/enums/replacementType"
      },
      "subType": "select",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "STRING"
    },
    "replacementPattern": {
      "displayName": "Replacement Pattern",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 1
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "replacementType",
        "expectedValue": "STRING"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "***"
    }
  },
  "metadata": {
    "minAgentVersion": "1.295",
    "appName": "Debugger",
    "addItemButton": "Add rule"
  },
  "uiCustomization": {
    "table": {
      "columns": [
        {
          "displayName": "Rule Name",
          "builtinColumnRef": "summary"
        },
        {
          "id": "ruleType",
          "displayName": "Rule Type",
          "propertyRef": "./ruleType"
        }
      ],
      "emptyState": {
        "text": "No rules defined"
      }
    }
  }
}