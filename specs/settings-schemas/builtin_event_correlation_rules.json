{
  "dynatrace": "1",
  "schemaId": "builtin:event-correlation-rules",
  "displayName": "Event correlation rule",
  "description": "Allows you to define rules for correlating events.",
  "documentation": "",
  "version": "2.2",
  "multiObject": true,
  "ordered": true,
  "maxObjects": 100,
  "maturity": "IN_DEVELOPMENT",
  "allowedScopes": [
    "environment"
  ],
  "enums": {},
  "types": {},
  "properties": {
    "displayName": {
      "displayName": "Display name",
      "description": "Name of the rule",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "TRIMMED"
        },
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "enabled": {
      "displayName": "Enabled",
      "description": "If this is true, the rule is used when correlating events",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": true
    },
    "timeWindow": {
      "displayName": "Time window",
      "description": "Other events within this time window are considered for correlation.",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "TRIMMED"
        },
        {
          "type": "PATTERN",
          "customMessage": "Only a positive duration is allowed",
          "pattern": "^[0-9]+\\s?[smhd]$"
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "time-window-validator",
          "skipAsyncValidation": false
        },
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": "2m"
    },
    "groupingFields": {
      "displayName": "Grouping fields",
      "description": "Fields used to group events. Groups are created based on the values of the grouping fields.",
      "documentation": "",
      "type": "set",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": "text",
        "constraints": [
          {
            "type": "LENGTH",
            "maxLength": 256,
            "minLength": 1
          },
          {
            "type": "NOT_BLANK"
          },
          {
            "type": "TRIMMED"
          }
        ]
      },
      "nullable": false,
      "minObjects": 1,
      "maxObjects": 10,
      "modificationPolicy": "DEFAULT"
    },
    "matchingCondition": {
      "displayName": "Matching condition",
      "description": "Matching condition to check if an event matches the correlation rule.",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "TRIMMED"
        },
        {
          "type": "LENGTH",
          "maxLength": 4096,
          "minLength": 1
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "matching-condition-validator",
          "skipAsyncValidation": false
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "correlationNamespace": {
      "displayName": "Correlation namespace",
      "description": "Optional namespace for cross-rule correlation. Rules sharing the same namespace produce compatible grouping keys, enabling events matched by different rules to correlate to the same problem.",
      "documentation": "",
      "type": "text",
      "nullable": true,
      "constraints": [
        {
          "type": "TRIMMED"
        },
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    }
  }
}