{
  "dynatrace": "1",
  "schemaId": "builtin:rum.web.xhr-exclusion",
  "displayName": "Exclude XHR requests from monitoring",
  "description": "Specify a regular expression to match all URLs that should be excluded from becoming XHR actions. \n\nDynatrace supports the JavaScript Regular Expressions syntax. The separation between different protocols of the URIs is not supported (every protocol of the URI will be excluded).",
  "documentation": "",
  "schemaGroups": [
    "group:capturing",
    "group:capturing.exclusions"
  ],
  "version": "1.0.4",
  "multiObject": true,
  "ordered": true,
  "maxObjects": 20,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "APPLICATION"
  ],
  "enums": {},
  "types": {},
  "properties": {
    "xhrExclusionRule": {
      "displayName": "XHR exclusion rule",
      "description": "",
      "documentation": "**Examples:**\n\n   - \\\\/segment1\\\\/segment2\n   - dynatrace\\\\.com\n   - www\\\\.dynatrace\\\\.com\\\\/segment1\\\\/.*[a-zA-Z]\n   - www\\\\.dynatrace\\\\.com:8080\n   - www\\\\.dynatrace\\\\.com:([0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\n   - www\\\\.dynatrace\\\\.com\\\\?param1=value1&param2=.*[a-zA-Z]\n",
      "type": "text",
      "subType": "safe_regex",
      "nullable": false,
      "constraints": [
        {
          "type": "REGEX",
          "disallowDangerousRegex": true
        },
        {
          "type": "LENGTH",
          "maxLength": 500,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    }
  },
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "uniqueProperties": [
        "xhrExclusionRule"
      ],
      "flattenCollections": false
    },
    {
      "type": "MULTI_SCOPE_CUSTOM_VALIDATOR_REF",
      "customMessage": "The number of XHR exclusion rules across all applications exceeds the tenant-wide limit.",
      "customValidatorId": "RumXhrExclusionTenantWideLimitsValidator",
      "skipAsyncValidation": false
    }
  ],
  "metadata": {
    "addItemButton": "Add an XHR exclusion rule"
  }
}