{
  "dynatrace": "1",
  "schemaId": "builtin:rum.web.request-errors",
  "displayName": "Request errors",
  "description": "Create capture and detection rules to include request errors in your Apdex calculations or Davis AI problem detection and analysis.\nFor more details, see [Configure request errors](https://dt-url.net/13020hh).",
  "documentation": "",
  "schemaGroups": [
    "group:rum-errors"
  ],
  "version": "1.0.3",
  "multiObject": false,
  "maxObjects": 1,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "APPLICATION",
    "environment-default"
  ],
  "enums": {
    "UrlFilter": {
      "displayName": "UrlFilter",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "BEGINS_WITH",
          "displayName": "URL begins with"
        },
        {
          "value": "ENDS_WITH",
          "displayName": "URL ends with"
        },
        {
          "value": "CONTAINS",
          "displayName": "URL contains"
        },
        {
          "value": "EQUALS",
          "displayName": "URL equals"
        }
      ],
      "type": "enum"
    }
  },
  "types": {
    "CaptureSettings": {
      "version": "0",
      "versionInfo": "",
      "displayName": "CaptureSettings",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "capture": {
          "displayName": "Capture this error",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        },
        "impactApdex": {
          "displayName": "Include error in Apdex calculations",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "precondition": {
            "type": "EQUALS",
            "property": "capture",
            "expectedValue": true
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        },
        "considerForAi": {
          "displayName": "Include error in Davis AI problem detection and analysis",
          "description": "[View more details](https://dt-url.net/hd580p2k)",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "precondition": {
            "type": "EQUALS",
            "property": "capture",
            "expectedValue": true
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        }
      },
      "type": "object"
    },
    "FilterSettings": {
      "version": "0",
      "versionInfo": "",
      "displayName": "FilterSettings",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "filter": {
          "displayName": "Filter by URL",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/enums/UrlFilter"
          },
          "nullable": true,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "url": {
          "displayName": "URL",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "NOT_BLANK"
            },
            {
              "type": "LENGTH",
              "maxLength": 4096
            }
          ],
          "precondition": {
            "type": "NOT",
            "precondition": {
              "type": "NULL",
              "property": "filter"
            }
          },
          "metadata": {
            "placeholder": "Type a valid URL or IP address…"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        }
      },
      "type": "object"
    },
    "RequestErrorRule": {
      "version": "0",
      "versionInfo": "",
      "displayName": "RequestErrorRule",
      "summaryPattern": "{errorCodes} {considerFailedImages} {considerCspViolations} {captureSettings.capture} {captureSettings.impactApdex} {captureSettings.considerForAi} {filterSettings.url}",
      "description": "",
      "documentation": "",
      "properties": {
        "errorCodes": {
          "displayName": "Match by error code",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": true,
          "constraints": [
            {
              "type": "LENGTH",
              "maxLength": 500,
              "minLength": 1
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customMessage": "The entered rules are not valid",
              "customValidatorId": "httpErrorCodes",
              "skipAsyncValidation": false
            }
          ],
          "metadata": {
            "placeholder": "For example, 401-409, 500"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "considerFailedImages": {
          "displayName": "Match by errors that have failed image requests",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        },
        "considerCspViolations": {
          "displayName": "Match by errors that have CSP violations",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "metadata": {
            "minAgentVersion": "1.207"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        },
        "filterSettings": {
          "displayName": "Filter settings",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/types/FilterSettings"
          },
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "captureSettings": {
          "displayName": "Capture settings",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/types/CaptureSettings"
          },
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        }
      },
      "constraints": [
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customMessage": "Enable at least one matching option",
          "customValidatorId": "RumAppRequestErrorsValidator",
          "skipAsyncValidation": false
        }
      ],
      "type": "object"
    }
  },
  "properties": {
    "ignoreRequestErrorsInApdexCalculation": {
      "displayName": "Ignore request errors in Apdex calculations",
      "description": "This setting overrides Apdex settings for individual rules listed below",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": false
    },
    "errorRules": {
      "displayName": "",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": {
          "$ref": "#/types/RequestErrorRule"
        }
      },
      "nullable": false,
      "constraints": [
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customMessage": "Duplicate error rule found",
          "customValidatorId": "RumAppRequestErrorsSchemaValidator",
          "skipAsyncValidation": false
        }
      ],
      "metadata": {
        "addItemButton": "Add request error rule"
      },
      "uiCustomization": {
        "table": {
          "columns": [
            {
              "id": "capture",
              "displayName": "Capture",
              "propertyRef": "./captureSettings/capture"
            },
            {
              "id": "impactApdex",
              "displayName": "Impact Apdex",
              "propertyRef": "./captureSettings/impactApdex"
            },
            {
              "id": "considerForAi",
              "displayName": "Consider for Davis",
              "propertyRef": "./captureSettings/considerForAi"
            }
          ]
        }
      },
      "minObjects": 0,
      "maxObjects": 110,
      "modificationPolicy": "DEFAULT"
    }
  }
}