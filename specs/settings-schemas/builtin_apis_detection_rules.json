{"dynatrace":"1","schemaId":"builtin:apis.detection-rules","displayName":"API detection rules","description":"Modern applications use a lot of different frameworks, so stacktraces in method hotspots and exceptions can become quite long. APIs allow you to spot a component and the respective ownership that is responsible for a hotspot or degradation faster.","documentation":"API detection rules look at a stacktrace frame and classify it based on classes (Java, .NET and PHP) or files (Node.js, PHP and GO) depending on the technology. The rules are executed in order and the first match decides the API. Marking APIs as third party will allow you to focus on non-third party APIs.","schemaGroups":["group:service-monitoring"],"version":"3.1.5","multiObject":true,"ordered":true,"maxObjects":100,"maturity":"GENERAL_AVAILABILITY","allowedScopes":["environment"],"enums":{"technology":{"displayName":"Technology","description":"","documentation":"","items":[{"value":"Go","displayName":"Go"},{"value":"Nodejs","displayName":"Node.js"},{"value":"PHP","displayName":"PHP"},{"value":"Java","displayName":"Java"},{"value":"dotNet","displayName":".NET"},{"value":"Python","displayName":"Python"}],"type":"enum"},"matcher":{"displayName":"Matcher","description":"","documentation":"","items":[{"value":"BEGINS_WITH","displayName":"begins with"},{"value":"CONTAINS","displayName":"contains"}],"type":"enum"},"base":{"displayName":"Base","description":"","documentation":"","items":[{"value":"FQCN","displayName":"Fully qualified class name (Java, .NET, PHP)"},{"value":"FILE_NAME","displayName":"File name (Node.js, PHP)"},{"value":"PACKAGE","displayName":"Package (Go)"}],"type":"enum"}},"types":{"apiRule":{"version":"0","versionInfo":"","displayName":"API Rule","summaryPattern":"Matches if the {base} {matcher} ''{pattern}''.","description":"","documentation":"","properties":{"base":{"displayName":"Base","description":"","documentation":"","type":{"$ref":"#/enums/base"},"nullable":false,"maxObjects":