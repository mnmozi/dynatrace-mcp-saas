{
  "dynatrace": "1",
  "schemaId": "builtin:synthetic.browser.outage-handling",
  "displayName": "Outage handling",
  "description": "Dynatrace can generate problems for both global outages and/or local outages based on the availability of either all configured locations or only individual locations over consecutive runs.",
  "documentation": "",
  "schemaGroups": [
    "group:web-and-mobile-monitoring",
    "group:web-and-mobile-monitoring.browser-monitor-default-settings"
  ],
  "version": "1.3.3",
  "multiObject": false,
  "maxObjects": 1,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "SYNTHETIC_TEST",
    "environment"
  ],
  "enums": {},
  "types": {},
  "properties": {
    "globalOutages": {
      "displayName": "Generate a problem and send an alert when the monitor is unavailable at all configured locations.",
      "description": "",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": true
    },
    "globalConsecutiveOutageCountThreshold": {
      "displayName": "Alert if all locations are unable to access my web application",
      "description": "",
      "documentation": "",
      "type": "integer",
      "subType": "datasource",
      "datasource": {
        "identifier": "consecutive_outage_count_datasource",
        "filterProperties": [],
        "resetValue": "NEVER",
        "validate": true,
        "fullContext": false,
        "useApiSearch": false
      },
      "nullable": false,
      "constraints": [
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customMessage": "Consecutive outage count not supported. Must be one of 1, 2, 3 or 5.",
          "customValidatorId": "synthetic_monitor_consecutive_outage_count_validator",
          "skipAsyncValidation": false
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "globalOutages",
        "expectedValue": true
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": 1
    },
    "localOutages": {
      "displayName": "Generate a problem and send an alert when the monitor is unavailable for one or more consecutive runs at any location.",
      "description": "",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": false
    },
    "localLocationOutageCountThreshold": {
      "displayName": "Alert if at least",
      "description": "",
      "documentation": "",
      "type": "integer",
      "subType": "datasource",
      "datasource": {
        "identifier": "synthetic_location_count_datasource",
        "filterProperties": [],
        "resetValue": "NEVER",
        "validate": false,
        "fullContext": false,
        "useApiSearch": false
      },
      "nullable": false,
      "constraints": [
        {
          "type": "RANGE",
          "minimum": 0
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customMessage": "Invalid location count. Location count must be 1 on the tenant level.",
          "customValidatorId": "synthetic_tenant_level_location_count_validator",
          "skipAsyncValidation": false
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "localOutages",
        "expectedValue": true
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": 1
    },
    "localConsecutiveOutageCountThreshold": {
      "displayName": "are unable to access my web application",
      "description": "",
      "documentation": "",
      "type": "integer",
      "subType": "datasource",
      "datasource": {
        "identifier": "consecutive_outage_count_datasource",
        "filterProperties": [],
        "resetValue": "NEVER",
        "validate": true,
        "fullContext": false,
        "useApiSearch": false
      },
      "nullable": false,
      "constraints": [
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customMessage": "Consecutive outage count not supported. Must be one of 1, 2, 3 or 5.",
          "customValidatorId": "synthetic_monitor_consecutive_outage_count_validator",
          "skipAsyncValidation": false
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "localOutages",
        "expectedValue": true
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": 3
    },
    "retryOnError": {
      "displayName": "Automatic retry on error.",
      "description": "When enabled, which is the default, failing monitor executions are retried immediately one time to avoid false positives and only the second result is used. When disabled, we use the first result right away.\nRequires ActiveGate version 1.207+ for private locations.",
      "documentation": "",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": true
    }
  },
  "constraints": [
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customValidatorId": "synthetic-monitor-count-validator",
      "skipAsyncValidation": false
    }
  ]
}