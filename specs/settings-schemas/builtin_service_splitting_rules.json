{
  "dynatrace": "1",
  "schemaId": "builtin:service-splitting-rules",
  "displayName": "Service splitting",
  "description": "Define rules to split services based on resource attributes defined in the [Semantic Dictionary](https://docs.dynatrace.com/docs/discover-dynatrace/references/semantic-dictionary/fields) and custom attributes. Rules are evaluated in order and the first matching rule applies.",
  "documentation": "",
  "schemaGroups": [
    "group:service-detection"
  ],
  "version": "0.0.16",
  "multiObject": true,
  "ordered": true,
  "maxObjects": 1000,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "CLOUD_APPLICATION_NAMESPACE",
    "KUBERNETES_CLUSTER",
    "HOST_GROUP",
    "environment"
  ],
  "enums": {},
  "types": {
    "Rule": {
      "version": "0.0.1",
      "versionInfo": "",
      "displayName": "Rule",
      "summaryPattern": "{ruleName}",
      "description": "",
      "documentation": "",
      "properties": {
        "ruleName": {
          "displayName": "Rule name",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "NOT_EMPTY"
            },
            {
              "type": "TRIMMED"
            },
            {
              "type": "LENGTH",
              "maxLength": 500,
              "minLength": 1
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        },
        "description": {
          "displayName": "Description",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": true,
          "constraints": [
            {
              "type": "LENGTH",
              "maxLength": 5000,
              "minLength": 1
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "condition": {
          "displayName": "Matching condition",
          "description": "Limits the scope of the service splitting rule using [DQL matcher](https://dt-url.net/l603wby) conditions on resource attributes.",
          "documentation": " A rule is applied only if the condition matches, otherwise the ruleset evaluation continues.\n\nIf empty, the condition will always match.",
          "type": "text",
          "subType": "code",
          "nullable": true,
          "constraints": [
            {
              "type": "LENGTH",
              "maxLength": 50000,
              "minLength": 2
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "dql-condition-validator",
              "skipAsyncValidation": false
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "only-resource-and-custom-attributes-dql-validator",
              "skipAsyncValidation": false
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "forbidden-attributes-dql-validator",
              "skipAsyncValidation": false
            }
          ],
          "metadata": {
            "placeholder": "matchesValue(k8s.cluster.name, \"com-sales-*\")"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "serviceSplittingAttributes": {
          "displayName": "Split services by resource attributes",
          "description": "Define the entire set of resource attributes that should split your services in the matching scope.",
          "documentation": "Each attribute that exists will contribute to the final service ID.",
          "type": "set",
          "items": {
            "displayName": "",
            "description": "",
            "documentation": "",
            "type": {
              "$ref": "#/types/splitBy"
            }
          },
          "nullable": false,
          "minObjects": 0,
          "maxObjects": 10,
          "modificationPolicy": "DEFAULT"
        }
      },
      "type": "object"
    },
    "splitBy": {
      "version": "0.0.1",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "{key}",
      "description": "",
      "documentation": "",
      "properties": {
        "key": {
          "displayName": "Attribute key",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "NOT_EMPTY"
            },
            {
              "type": "TRIMMED"
            },
            {
              "type": "LENGTH",
              "maxLength": 500,
              "minLength": 1
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "only-resource-and-custom-attributes-single-attribute-validator",
              "skipAsyncValidation": false
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "forbidden-attributes-single-attribute-validator",
              "skipAsyncValidation": false
            },
            {
              "type": "CUSTOM_VALIDATOR_REF",
              "customValidatorId": "key-value-pair-warning-single-attribute-validator",
              "skipAsyncValidation": false
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "enabled": {
      "displayName": "Enabled",
      "description": "",
      "documentation": "If enabled, the rule will be evaluated.",
      "type": "boolean",
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "ALWAYS",
      "default": true
    },
    "rule": {
      "displayName": "Rule",
      "description": "",
      "documentation": "",
      "type": {
        "$ref": "#/types/Rule"
      },
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    }
  },
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "customMessage": "Rule name must be unique.",
      "uniqueProperties": [
        "rule.ruleName"
      ],
      "flattenCollections": false
    }
  ],
  "metadata": {
    "itemDisplayName": "New rule",
    "addItemButton": "Add rule"
  },
  "uiCustomization": {
    "table": {
      "columns": [
        {
          "displayName": "Rule name",
          "builtinColumnRef": "summary"
        }
      ]
    }
  }
}