          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "metadata": {
            "minAgentVersion": "1.297"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        }
