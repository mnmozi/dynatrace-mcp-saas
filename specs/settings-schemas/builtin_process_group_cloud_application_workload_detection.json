{
  "dynatrace": "1",
  "schemaId": "builtin:process-group.cloud-application-workload-detection",
  "displayName": "Cloud application and workload detection",
  "description": "Enabling this setting merges processes of similar workloads into process groups, and consequently, services. Please note that [fine-grained process detection rules](https://www.dynatrace.com/support/help/shortlink/process-groups) will still be applied, while ignoring container or platform specific properties.",
  "documentation": "",
  "schemaGroups": [
    "group:processes-and-containers.containers",
    "group:processes-and-containers"
  ],
  "version": "1.5",
  "multiObject": false,
  "maxObjects": 1,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "environment"
  ],
  "enums": {
    "MatchEnum": {
      "displayName": "Match operator",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "EXISTS",
          "displayName": "exists"
        },
        {
          "value": "EQUALS",
          "displayName": "equals"
        },
        {
          "value": "NOT_EQUALS",
          "displayName": "does not equal"
        },
        {
          "value": "CONTAINS",
          "displayName": "contains"
        },
        {
          "value": "NOT_CONTAINS",
          "displayName": "does not contain"
        },
        {
          "value": "STARTS",
          "displayName": "starts with"
        },
        {
          "value": "NOT_STARTS",
          "displayName": "does not start with"
        },
        {
          "value": "ENDS",
          "displayName": "ends with"
        },
        {
          "value": "NOT_ENDS",
          "displayName": "does not end with"
        }
      ],
      "type": "enum"
    }
  },
  "types": {
    "InclusionToggles": {
      "version": "0",
      "versionInfo": "",
      "displayName": "InclusionToggles",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "incNamespace": {
          "displayName": "Namespace name",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        },
        "incBasepod": {
          "displayName": "Base pod name",
          "description": "",
          "documentation": "E.g. \"cloud-credential-operator-\" for \"cloud-credential-operator-5ff6dbff57-gszgq\"",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        },
        "incContainer": {
          "displayName": "Container name",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        },
        "incStage": {
          "displayName": "Stage",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        },
        "incProduct": {
          "displayName": "Product",
          "description": "",
          "documentation": "If Product is enabled and has no value, it defaults to Base pod name",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": true
        }
      },
      "type": "object"
    },
    "MatchFilter": {
      "version": "0",
      "versionInfo": "",
      "displayName": "MatchFilter",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "matchOperator": {
          "displayName": "Match operator",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/enums/MatchEnum"
          },
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": "EQUALS"
        },
        "namespace": {
          "displayName": "Namespace name",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH",
              "maxLength": 255,
              "minLength": 1
            }
          ],
          "precondition": {
            "type": "NOT",
            "precondition": {
              "type": "EQUALS",
              "property": "matchOperator",
              "expectedValue": "EXISTS"
            }
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        }
      },
      "type": "object"
    },
    "FilterComplex": {
      "version": "0",
      "versionInfo": "",
      "displayName": "",
