{
  "dynatrace": "1",
  "schemaId": "builtin:rum.web.capture-custom-properties",
  "displayName": "Custom Properties Capture Restrictions",
  "description": "Define specific properties to restrict event/session capturing, with options to allow by property name or allow all properties.",
  "documentation": "",
  "version": "0.4.1",
  "multiObject": false,
  "maxObjects": 1,
  "maturity": "EARLY_ADOPTER",
  "allowedScopes": [
    "APPLICATION",
    "MOBILE_APPLICATION"
  ],
  "enums": {
    "FieldDataType": {
      "displayName": "Datatype",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "STRING",
          "displayName": "String"
        },
        {
          "value": "NUMBER",
          "displayName": "Number"
        },
        {
          "value": "BOOLEAN",
          "displayName": "Boolean"
        }
      ],
      "type": "enum"
    }
  },
  "types": {
    "CustomProperty": {
      "version": "0.1",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "{fieldName}",
      "description": "",
      "documentation": "",
      "properties": {
        "fieldName": {
          "displayName": "Field name",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "PATTERN",
              "customMessage": "Please choose a valid field name.",
              "pattern": "^[a-zA-Z0-9._]+$"
            },
            {
              "type": "LENGTH",
              "maxLength": 500,
              "minLength": 1
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        },
        "caseInsensitiveNamingEnabled": {
          "displayName": "Field name validation should be case-insensitive",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        },
        "fieldDataType": {
          "displayName": "Datatype",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/enums/FieldDataType"
          },
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": "STRING"
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "customEventPropertiesAllowList": {
      "displayName": "List of allowed custom event properties",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": {
          "$ref": "#/types/CustomProperty"
        }
      },
      "nullable": false,
      "metadata": {
        "addItemButton": "Allow new event property"
      },
      "minObjects": 0,
      "maxObjects": 100,
      "modificationPolicy": "DEFAULT"
    },
    "customSessionPropertiesAllowList": {
      "displayName": "List of allowed custom session properties",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": {
          "$ref": "#/types/CustomProperty"
        }
      },
      "nullable": false,
      "metadata": {
        "addItemButton": "Allow new session property"
      },
      "minObjects": 0,
      "maxObjects": 100,
      "modificationPolicy": "DEFAULT"
    }
  },
  "constraints": [
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customMessage": "Only a combined amount of 20 custom event and session properties can be defined.",
      "customValidatorId": "rumAppCaptureCustomPropertiesValidator",
      "skipAsyncValidation": false
    },
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customMessage": "Duplicate field names of case-insensitive properties are not allowed.",
      "customValidatorId": "rumAppCaptureCustomPropertiesCaseInsensitiveValidator",
      "skipAsyncValidation": false
    },
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customMessage": "Field names must not contain the prefix 'event_properties.' or 'session_properties.'",
      "customValidatorId": "rumAppCaptureCustomPropertiesPrefixValidator",
      "skipAsyncValidation": false
    }
  ]
}