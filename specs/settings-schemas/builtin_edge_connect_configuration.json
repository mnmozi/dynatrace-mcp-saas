{
  "dynatrace": "1",
  "schemaId": "builtin:edge-connect.configuration",
  "displayName": "EdgeConnect Configuration",
  "description": "Configuration for EdgeConnect configs that enable Dynatrace to route requests into customer environments.",
  "documentation": "An EdgeConnect maps specified host patterns and host mappings to an EdgeConnect config. Host patterns define which hosts are routed through this EdgeConnect. Host mappings allow optional rewriting of hostnames.",
  "version": "0.0.1",
  "multiObject": true,
  "ordered": false,
  "maxObjects": 500,
  "maturity": "EARLY_ADOPTER",
  "allowedScopes": [
    "environment"
  ],
  "keyProperty": "name",
  "enums": {},
  "types": {
    "HostMapping": {
      "version": "0",
      "versionInfo": "",
      "displayName": "Host Mapping",
      "summaryPattern": "{from} -> {to}",
      "description": "Maps a source hostname to a target hostname.",
      "documentation": "",
      "properties": {
        "from": {
          "displayName": "From",
          "description": "The source hostname to be mapped. Must be a valid IP or domain name.",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "NOT_BLANK"
            },
            {
              "type": "LENGTH",
              "maxLength": 253
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        },
        "to": {
          "displayName": "To",
          "description": "The target hostname to map to. Must be a valid IP or domain name.",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "NOT_BLANK"
            },
            {
              "type": "LENGTH",
              "maxLength": 253
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "displayName": "Name",
      "description": "The name of the EdgeConnect configuration.",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "LENGTH",
          "maxLength": 50,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "NEVER",
      "default": ""
    },
    "hostPatterns": {
      "displayName": "Host Patterns",
      "description": "Host patterns defining which hosts are routed through this EdgeConnect. Each pattern is either an IP or a domain name which may contain a wildcard ('*') as the leftmost label.",
      "documentation": "",
      "type": "set",
      "items": {
        "displayName": "Host Pattern",
        "description": "Either an IP or a domain name. Wildcards ('*') are allowed only as the leftmost label followed by at least two labels.",
        "documentation": "",
        "type": "text",
        "constraints": [
          {
            "type": "NOT_BLANK"
          },
          {
            "type": "LENGTH",
            "maxLength": 253
          }
        ]
      },
      "nullable": false,
      "minObjects": 0,
      "maxObjects": 1000,
      "modificationPolicy": "DEFAULT"
    },
    "hostMappings": {
      "displayName": "Host Mappings",
      "description": "Optional host mappings for rewriting source hostnames to target hostnames. The 'from' field must be unique across all mappings.",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "Host Mapping",
        "description": "A mapping from a source hostname to a target hostname.",
        "documentation": "",
        "type": {
          "$ref": "#/types/HostMapping"
        }
      },
      "nullable": false,
      "minObjects": 0,
      "maxObjects": 100,
      "modificationPolicy": "DEFAULT"
    },
    "oauthClientId": {
      "displayName": "OAuth Client ID",
      "description": "The OAuth 2.0 client identifier for this EdgeConnect.",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "NOT_BLANK"
        },
        {
          "type": "LENGTH",
          "maxLength": 200
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "NEVER",
      "default": ""
    },
    "managedByDynatraceOperator": {
      "displayName": "Managed by Dynatrace Operator",
      "description": "Indicates whether this EdgeConnect is managed by the Dynatrace Operator.",
      "documentation": "",
      "type": "boolean",
      "nullable": true,
      "maxObjects": 1,
      "modificationPolicy": "NEVER"
    }
  },
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "customMessage": "Key property must have unique value",
      "uniqueProperties": [
        "name"
      ],
      "flattenCollections": false
    }
  ]
}