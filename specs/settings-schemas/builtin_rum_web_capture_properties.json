{
  "dynatrace": "1",
  "schemaId": "builtin:rum.web.capture-properties",
  "displayName": "Capture properties",
  "description": "Capture and collect properties with metadata-capturing rules.",
  "documentation": "",
  "version": "0.7",
  "multiObject": false,
  "maxObjects": 1,
  "maturity": "EARLY_ADOPTER",
  "allowedScopes": [
    "APPLICATION"
  ],
  "enums": {
    "CapturingSteps": {
      "displayName": "Capturing step",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "COOKIE_ACCESSOR",
          "displayName": "Access cookie"
        },
        {
          "value": "DOM_ATTRIBUTE_ACCESSOR",
          "displayName": "Access DOM attribute"
        },
        {
          "value": "JSON_PARSER",
          "displayName": "Parse JSON"
        },
        {
          "value": "PROPERTY_ACCESSOR",
          "displayName": "Access property"
        },
        {
          "value": "QUERY_SELECTOR",
          "displayName": "Execute query selector"
        }
      ],
      "type": "enum"
    }
  },
  "types": {
    "CapturingStep": {
      "version": "0.2",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "{captureType} {captureValue}",
      "description": "",
      "documentation": "",
      "properties": {
        "captureType": {
          "displayName": "Capturing type",
          "description": "",
          "documentation": "",
          "type": {
            "$ref": "#/enums/CapturingSteps"
          },
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": "COOKIE_ACCESSOR"
        },
        "captureValue": {
          "displayName": "Value to capture",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH"
            }
          ],
          "precondition": {
            "type": "NOT",
            "precondition": {
              "type": "EQUALS",
              "property": "captureType",
              "expectedValue": "JSON_PARSER"
            }
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        }
      },
      "type": "object"
    },
    "CapturedEventProperty": {
      "version": "0.2",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "{propertyKey}",
      "description": "",
      "documentation": "",
      "properties": {
        "propertyKey": {
          "displayName": "Property key",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH"
            },
            {
              "type": "PATTERN",
              "customMessage": "Please choose a valid property key.",
              "pattern": "^[a-zA-Z0-9._]+$"
            },
            {
              "type": "PATTERN",
              "customMessage": "Property key must not contain 'event_properties.'",
              "pattern": "^((?!event_properties\\.).)*$"
            },
            {
              "type": "PATTERN",
              "customMessage": "Property key must not contain 'session_properties.'",
              "pattern": "^((?!session_properties\\.).)*$"
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        },
        "capturingSteps": {
          "displayName": "Capturing steps",
          "description": "",
          "documentation": "",
          "type": "list",
          "items": {
            "displayName": "",
            "description": "",
            "documentation": "",
            "type": {
              "$ref": "#/types/CapturingStep"
            }
          },
          "nullable": false,
          "metadata": {
            "addItemButton": "New capturing step"
          },
          "minObjects": 0,
          "maxObjects": 100,
          "modificationPolicy": "DEFAULT"
        }
      },
      "type": "object"
    },
    "AllowedApiReportedProperty": {
      "version": "0.2",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "{propertyKey}",
      "description": "",
      "documentation": "",
      "properties": {
        "propertyKey": {
          "displayName": "Property key",
          "description": "",
          "documentation": "",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH"
            },
            {
              "type": "PATTERN",
              "customMessage": "Please choose a valid property key.",
              "pattern": "^[a-zA-Z0-9._]+$"
            },
            {
              "type": "PATTERN",
              "customMessage": "Property key must not contain 'event_properties.'",
              "pattern": "^((?!event_properties\\.).)*$"
            },
            {
              "type": "PATTERN",
              "customMessage": "Property key must not contain 'session_properties.'",
              "pattern": "^((?!session_properties\\.).)*$"
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": ""
        },
        "caseInsensitivePropertyKey": {
          "displayName": "Property key validation should be case-insensitive.",
          "description": "",
          "documentation": "",
          "type": "boolean",
          "nullable": false,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": false
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "capturedEventProperties": {
      "displayName": "Captured event properties",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": {
          "$ref": "#/types/CapturedEventProperty"
        }
      },
      "nullable": false,
      "constraints": [
        {
          "type": "UNIQUE",
          "customMessage": "Duplicate property keys are not allowed.",
          "uniqueProperties": [
            "propertyKey"
          ]
        }
      ],
      "metadata": {
        "addItemButton": "New captured event property"
      },
      "minObjects": 0,
      "maxObjects": 1000,
      "modificationPolicy": "DEFAULT"
    },
    "allowedApiReportedProperties": {
      "displayName": "Allowed API-reported properties",
      "description": "",
      "documentation": "",
      "type": "list",
      "items": {
        "displayName": "",
        "description": "",
        "documentation": "",
        "type": {
          "$ref": "#/types/AllowedApiReportedProperty"
        }
      },
      "nullable": false,
      "constraints": [
        {
          "type": "UNIQUE",
          "customMessage": "Duplicate property keys are not allowed.",
          "uniqueProperties": [
            "propertyKey"
          ]
        }
      ],
      "metadata": {
        "addItemButton": "New allowed API-reported property"
      },
      "minObjects": 0,
      "maxObjects": 1000,
      "modificationPolicy": "DEFAULT"
    }
  },
  "constraints": [
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customMessage": "Duplicate property keys of case-insensitive properties are not allowed.",
      "customValidatorId": "capturePropertiesCaseInsensitiveValidator",
      "skipAsyncValidation": false
    },
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customMessage": "The number of captured properties or capturing steps exceeds the configured limit.",
      "customValidatorId": "capturePropertiesLimitsValidator",
      "skipAsyncValidation": false
    }
  ]
}