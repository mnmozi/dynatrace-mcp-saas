{"dynatrace":"1","schemaId":"builtin:endpoint-detection-rules","displayName":"Endpoint detection","description":"Define rules to detect requests on endpoints based on span attributes defined in the [Semantic Dictionary](https://docs.dynatrace.com/docs/discover-dynatrace/references/semantic-dictionary/fields) and custom attributes. Rules are evaluated in order and the first matching rule applies.","documentation":"","schemaGroups":["group:service-detection"],"version":"1.0.3","multiObject":true,"ordered":true,"maxObjects":1000,"maturity":"GENERAL_AVAILABILITY","allowedScopes":["CLOUD_APPLICATION_NAMESPACE","KUBERNETES_CLUSTER","HOST_GROUP","environment"],"enums":{"ActionToPerform":{"displayName":"ActionToPerform","description":"","documentation":"","items":[{"value":"DETECT_REQUEST_ON_ENDPOINT","displayName":"Detect request on endpoint"},{"value":"SUPPRESS_REQUEST","displayName":"Suppress request"}],"type":"enum"}},"types":{"Rule":{"version":"0","versionInfo":"","displayName":"Rule","summaryPattern":"{ruleName}","description":"","documentation":"","properties":{"ruleName":{"displayName":"Rule name","description":"","documentation":"","type":"text","nullable":false,"constraints":[{"type":"NOT_EMPTY"},{"type":"TRIMMED"},{"type":"LENGTH","maxLength":500,"minLength":1}],"maxObjects":1,"modificationPolicy":"DEFAULT","default":""},"description":{"displayName":"Description","description":"","documentation":"","type":"text","nullable":true,"constraints":[{"type":"LENGTH","maxLength":1000,"minLength":1}],"maxObjects":1,"modificationPolicy":"DEFAULT"},"condition":{"displayName":"Matching condition","description":"Limits the scope of the endpoint detection rule using [DQL matcher](https://dt-url.net/l603wby) conditions on span and resource attributes.","documentation":"A rule is applied only if the condition matches, otherwise the ruleset evaluation continues.\n\nIf empty, the condition will always match.","type":"text","subType":"code","nullable":true,"constraints":[{"type":"C