      "displayName": "Authentication type",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "basic",
          "displayName": "Basic authentication"
        },
        {
          "value": "oauth2",
          "displayName": "OAuth 2.0 (Early Adopter)"
        }
      ],
      "type": "enum"
    },
    "sendCredentials": {
      "displayName": "Send credentials",
