{
  "dynatrace": "1",
  "schemaId": "app:dynatrace.slack:connection",
  "displayName": "Slack",
  "description": "Authentication details for Slack API",
  "documentation": "(for more information read the [Slack api documentation](https://api.slack.com/authentication/basics/ \"Visit Slack document\"))",
  "version": "0.2",
  "multiObject": true,
  "ordered": false,
  "maxObjects": 100,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "environment"
  ],
  "enums": {},
  "types": {},
  "properties": {
    "name": {
      "displayName": "Connection name",
      "description": "Provide a unique and clearly identifiable connection name to your Slack App.",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "customMessage": "Name has to be between 1 and 50 characters long",
          "maxLength": 50,
          "minLength": 1
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "token": {
      "displayName": "Bot token",
      "description": "The bot token obtained from the Slack App Management UI.",
      "documentation": "Bot token in the format `xoxb-******`",
      "type": "secret",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "customMessage": "Token has to be between 5 and 500 characters long",
          "maxLength": 500,
          "minLength": 5
        },
        {
          "type": "PATTERN",
          "customMessage": "Not a valid Slack bot token",
          "pattern": "^xoxb-.*$"
        },
        {
          "type": "CUSTOM_VALIDATOR_REF",
          "customValidatorId": "validate-connection-schema",
          "skipAsyncValidation": false
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "externalApproval": {
      "displayName": "External approval",
      "description": "Accept external approvals can enable Slack users to directly respond to approval request.",
      "documentation": "",
      "type": "boolean",
      "nullable": true,
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    },
    "signingSecret": {
      "displayName": "Signing secret",
      "description": "The signing secret obtained from the Slack App Management UI.",
      "documentation": "",
      "type": "secret",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "customMessage": "Signing secret has to be between 5 and 500 characters long",
          "maxLength": 500,
          "minLength": 5
        }
      ],
      "precondition": {
        "type": "EQUALS",
        "property": "externalApproval",
        "expectedValue": true
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    }
  },
  "constraints": [
    {
      "type": "SECRET_RESUBMISSION",
      "customMessage": "For security reasons please re-enter the API token / Signing Secret before saving the configuration.",
      "checkAllProperties": false
    }
  ],
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "customMessage": "A connection with the same name already exists. Please provide a different name.",
      "uniqueProperties": [
        "name"
      ],
      "flattenCollections": false
    }
  ],
  "metadata": {
    "appName": "Slack"
  },
  "ownerBasedAccessControl": true
}