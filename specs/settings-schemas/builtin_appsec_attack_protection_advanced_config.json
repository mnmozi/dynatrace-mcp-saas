            "validate": true,
            "fullContext": false,
            "useApiSearch": false
          },
          "nullable": false,
          "metadata": {
            "sortItems": "disabled"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": "ANY"
        }
      },
      "type": "object"
    },
    "AttackHandling": {
      "version": "0",
      "versionInfo": "",
      "displayName": "AttackHandling",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "blockingStrategy": {
          "displayName": "Attack control",
          "description": "Note: Monitoring and blocking have been designed to carry a production-ready performance footprint.\nThe overhead is depending on your application, but should be negligible in most cases.",
          "documentation": "",
          "type": {
            "$ref": "#/enums/BlockingStrategy"
          },
          "nullable": false,
          "metadata": {
            "sortItems": "disabled"
          },
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": "MONITOR"
        }
      },
      "type": "object"
    },
    "Metadata": {
      "version": "0",
      "versionInfo": "",
      "displayName": "Metadata",
      "summaryPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "comment": {
          "displayName": "Comment",
