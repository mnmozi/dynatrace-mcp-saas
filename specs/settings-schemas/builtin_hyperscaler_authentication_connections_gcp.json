{
  "dynatrace": "1",
  "schemaId": "builtin:hyperscaler-authentication.connections.gcp",
  "displayName": "Connections to GCP environments",
  "description": "Connections to GCP for Dynatrace integrations",
  "documentation": "",
  "version": "0.0.5",
  "multiObject": true,
  "ordered": false,
  "maxObjects": 100,
  "maturity": "EARLY_ADOPTER",
  "allowedScopes": [
    "environment"
  ],
  "enums": {
    "ConsumersOfServiceAccountImpersonation": {
      "displayName": "Consumers",
      "description": "Dynatrace integrations that can use this connection",
      "documentation": "",
      "items": [
        {
          "value": "SVC:com.dynatrace.da",
          "displayName": "Data Acquisition"
        },
        {
          "value": "SVC:com.dynatrace.openpipeline",
          "displayName": "OpenPipeline"
        },
        {
          "value": "SVC:com.dynatrace.bo",
          "displayName": "Business Observability"
        }
      ],
      "type": "enum"
    },
    "Type": {
      "displayName": "Type",
      "description": "",
      "documentation": "",
      "items": [
        {
          "value": "serviceAccountImpersonation",
          "displayName": "Service Account Impersonation"
        }
      ],
      "type": "enum"
    }
  },
  "types": {
    "ServiceAccountImpersonation": {
      "version": "0",
      "versionInfo": "",
      "displayName": "",
      "summaryPattern": "",
      "searchPattern": "",
      "description": "",
      "documentation": "",
      "properties": {
        "serviceAccountId": {
          "displayName": "Service Account Id",
          "description": "Id of your Service Account",
          "documentation": "",
          "type": "text",
          "nullable": true,
          "constraints": [
            {
              "type": "LENGTH",
              "maxLength": 200,
              "minLength": 1
            }
          ],
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT"
        },
        "consumers": {
          "displayName": "Consumers",
          "description": "Dynatrace integrations that can use this connection",
          "documentation": "",
          "type": "list",
          "items": {
            "displayName": "",
            "description": "",
            "documentation": "",
            "type": {
              "$ref": "#/enums/ConsumersOfServiceAccountImpersonation"
            }
          },
          "nullable": false,
          "minObjects": 0,
          "maxObjects": 1,
          "modificationPolicy": "DEFAULT",
          "default": [
            "SVC:com.dynatrace.da"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "displayName": "Name",
      "description": "The name of the connection",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        },
        {
          "type": "PATTERN",
          "customMessage": "The symbol : is not allowed the name",
          "pattern": "^[^:]+$"
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "ALWAYS",
      "default": ""
    },
    "type": {
      "displayName": "Connection Type",
      "description": "GCP Authentication mechanism to be used by the connection",
      "documentation": "",
      "type": {
        "$ref": "#/enums/Type"
      },
      "nullable": false,
      "maxObjects": 1,
      "modificationPolicy": "NEVER",
      "default": "serviceAccountImpersonation"
    },
    "serviceAccountImpersonation": {
      "displayName": "",
      "description": "",
      "documentation": "",
      "type": {
        "$ref": "#/types/ServiceAccountImpersonation"
      },
      "nullable": false,
      "precondition": {
        "type": "EQUALS",
        "property": "type",
        "expectedValue": "serviceAccountImpersonation"
      },
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT"
    }
  },
  "constraints": [
    {
      "type": "CUSTOM_VALIDATOR_REF",
      "customValidatorId": "hyperscaler-authentication.hyperscaler-authentication:8080/internal/settings-validation/v0.1/validate-container/gcpConfiguration",
      "skipAsyncValidation": true
    }
  ],
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "customMessage": "There is another connection defined under this name.",
      "uniqueProperties": [
        "name"
      ],
      "flattenCollections": false
    }
  ],
  "metadata": {
    "$ref": "#/types/Metadata"
  },
  "ownerBasedAccessControl": true
