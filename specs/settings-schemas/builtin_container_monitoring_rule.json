      "nullable": false,
      "constraints": [
        {
          "type": "PATTERN",
          "customMessage": "Colon, comma and semicolon are not allowed",
          "pattern": "^[^;:,]*$"
        },
        {
          "type": "LENGTH",
          "maxLength": 1000,
          "minLength": 1
        }
      ],
      "precondition": {
        "type": "NOT",
        "precondition": {
