{
  "dynatrace": "1",
  "schemaId": "app:dynatrace.devobs.debugger:class.variables.collection",
  "displayName": "Class Variables Collection",
  "description": "Create class variables for use in Live Debugger sessions to help you better analyze and debug your applications.",
  "documentation": "",
  "schemaGroups": [
    "group:observability-for-developers"
  ],
  "version": "1.2",
  "multiObject": true,
  "ordered": true,
  "maxObjects": 10,
  "maturity": "GENERAL_AVAILABILITY",
  "allowedScopes": [
    "environment"
  ],
  "enums": {},
  "types": {},
  "properties": {
    "className": {
      "displayName": "Name of the class where collection should be applied",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        },
        {
          "type": "TRIMMED",
          "customMessage": "No leading or trailing whitespaces are allowed."
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    },
    "variableName": {
      "displayName": "Name of the variable inside class to be collected",
      "description": "",
      "documentation": "",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        },
        {
          "type": "TRIMMED",
          "customMessage": "No leading or trailing whitespaces are allowed."
        }
      ],
      "maxObjects": 1,
      "modificationPolicy": "DEFAULT",
      "default": ""
    }
  },
  "schemaConstraints": [
    {
      "type": "UNIQUE",
      "customMessage": "A record with such data already exists.",
      "uniqueProperties": [
        "className",
        "variableName"
      ],
      "flattenCollections": false
    }
  ],
  "metadata": {
    "appName": "Live Debugger"
  },
  "uiCustomization": {
    "table": {
      "columns": [
        {
          "id": "className",
          "displayName": "Class name",
          "propertyRef": "./className"
        },
        {
          "id": "variableName",
          "displayName": "Variable name",
          "propertyRef": "./variableName"
        }
      ],
      "emptyState": {
        "text": "No class variables defined"
      }
    }
  }
}