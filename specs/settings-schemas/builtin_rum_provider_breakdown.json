{"dynatrace":"1","schemaId":"builtin:rum.provider-breakdown","displayName":"Provider breakdown","description":"Set up rules that define how your applications' downloaded content resources (images, CSS, third party widgets, and more) are displayed and categorized for analysis. ","documentation":"Dynatrace uses the provider host names of downloaded resources to categorize content resources into either third party resources, CDN resources, or first party resources.  \n  \nDynatrace auto-detects over 1,000 content providers out-of-the-box, including Google, Amazon, Facebook, and many more. There's nothing you need to do to set up detection of resources. If you can't find your provider in the list below, you can add it manually. To learn more, visit [Configure 3rd-party and CDN content detection](https://dt-url.net/on02tdo).","schemaGroups":["group:web-and-mobile-monitoring","group:web-and-mobile-monitoring.content-resources"],"version":"1.0.8","multiObject":true,"ordered":true,"maxObjects":100,"maturity":"GENERAL_AVAILABILITY","allowedScopes":["environment"],"enums":{"ResourceType":{"displayName":"ResourceType","description":"","documentation":"","items":[{"value":"FirstParty","displayName":"1st party resources"},{"value":"ThirdParty","displayName":"3rd party resources"},{"value":"Cdn","displayName":"CDN resources"}],"type":"enum"}},"types":{"DomainNamePatternListObject":{"version":"0","versionInfo":"","displayName":"","summaryPattern":"{domainNamePattern}","description":"","documentation":"","properties":{"domainNamePattern":{"displayName":"Type your domain name pattern","description":"","documentation":"Use a ends-with pattern for this content provider's domain","type":"text","nullable":false,"constraints":[{"type":"LENGTH","maxLength":150,"minLength":1}],"metadata":{"placeholder":"E.g. .domain.com"},"maxObjects":1,"modificationPolicy":"DEFAULT","default":""}},"type":"object"}},"properties":{"resourceName":{"displayName":"Resource name","description":"","documentation